  "isGlobal": true,
  "info": {
    "description": "基于 Prometheus/Grafana 提供 Kubernetes 集群资源监控能力，包括 CPU、内存、磁盘、网络等资源层指标；适配 Kubernetes 1.35。",
    "document": "",
    "important": "安装前请在套件详情页配置 Prometheus StorageClass 与存储卷大小；需集群已启用 metrics-server 或 kubelet/cAdvisor 指标采集。"
  },
  "parameters": {
    "NODE_EXPORTER_PORT": "9100",
    "PROMETHEUS_REPLICAS": "1",
    "PROMETHEUS_STORAGE_CLASS": "please-provide-a-valid-storage-class-name",
    "PROMETHEUS_STORAGE_SIZE_PER_VOLUME": "20Gi",
    "KUBERNETES_CLUSTER": "default",
    "MONITOR_NAMESPACE": "openkuboard",
    "MONITOR_IMAGE_REGISTRY": ""
  },
  "parameterDefs": [
    {
      "name": "PROMETHEUS_STORAGE_CLASS",
      "category": "enum-from-hostReads",
      "hostRead": "storageclasses",
      "required": true,
      "default": "please-provide-a-valid-storage-class-name",
      "description": "为 Prometheus 提供持久化存储的 StorageClass 名称。"
    },
    {
      "name": "MONITOR_IMAGE_REGISTRY",
      "category": "enum-from-hostReads",
      "hostRead": "base_image_registry",
      "required": false,
      "default": "",
      "description": "镜像仓库主机覆盖（默认留空，使用官方公共源）。"
    },
    {
      "name": "KUBERNETES_CLUSTER",
      "category": "host-derived",
      "required": true,
      "default": "default",
      "description": "Kubernetes 集群在平台中的名称标识。"
    },
    {
      "name": "NODE_EXPORTER_PORT",
      "category": "user-editable",
      "required": true,
      "default": "9100",
      "description": "Node Exporter 监听端口（hostPort）。"
    },
    {
      "name": "PROMETHEUS_REPLICAS",
      "category": "user-editable",
      "required": true,
      "default": "1",
      "description": "Prometheus 实例数量。"
    },
    {
      "name": "PROMETHEUS_STORAGE_SIZE_PER_VOLUME",
      "category": "user-editable",
      "required": true,
      "default": "20Gi",
      "description": "每个 Prometheus 实例的 PVC 容量。"
    },
    {
      "name": "MONITOR_NAMESPACE",
      "category": "user-editable",
      "required": true,
      "default": "openkuboard",
      "description": "监控组件安装的 Kubernetes 命名空间。"
    }
  ],
  "permissions": [
    {
      "code": "monitor",
      "label": "资源监控",
      "labelEn": "Monitor",
      "children": [
        {
          "code": "monitor:view",
          "label": "查看监控",
          "labelEn": "View"
        },
        {
          "code": "monitor:config",
          "label": "监控配置",
          "labelEn": "Config",
          "children": [
            {
              "code": "monitor:config:edit",
              "label": "编辑配置",
              "labelEn": "Edit Config"
            }
          ]
        }
      ]
    }
  ],
  "resourceAccess": [
    {
      "group": "monitoring.coreos.com",
      "version": "v1",
      "resource": "prometheusrules",
      "namespaced": true,
      "actions": {
        "list": "monitor:view",
        "update": "monitor:config:edit"
      }
    }
  ],
  "hostReads": {
    "k8s": [
      "storageclasses",
      "namespaces"
    ],
    "settings": [
      "base_image_registry"
    ]
  },
  "serviceUI": [
    {
      "id": "grafana-home",
      "namespace": "{{parameters.MONITOR_NAMESPACE}}",
      "service": "grafana",
      "port": 3000,
      "path": "/",
      "target": "blank",
      "label": "Grafana 主页",
      "labelEn": "Grafana Home",
      "permission": "monitor:view"
    },
    {
      "id": "grafana",
      "namespace": "{{parameters.MONITOR_NAMESPACE}}",
      "service": "grafana",
      "port": 3000,
      "path": "/",
      "target": "blank",
      "label": "Grafana",
      "labelEn": "Grafana",
      "permission": "monitor:view"
    },
    {
      "id": "prometheus",
      "namespace": "{{parameters.MONITOR_NAMESPACE}}",
      "service": "prometheus-k8s",
      "port": 9090,
      "path": "/",
      "target": "blank",
      "label": "Prometheus 主页",
      "labelEn": "Prometheus Home",
      "permission": "monitor:view"
    },
    {
      "id": "alertmanager",
      "namespace": "{{parameters.MONITOR_NAMESPACE}}",
      "service": "alertmanager-main",
      "port": 9093,
      "path": "/",
      "target": "blank",
      "label": "告警管理主页",
      "labelEn": "Alertmanager Home",
      "permission": "monitor:view"
    }
  ],
