{
  "id": "vsphere-csi.addons.openkuboard.github.io",
  "name": "vSphere CSI 驱动",
  "version": "1.0.0",
  "lastUpdate": "2026-08-29",
  "maintainer": "openkuboard",
  "isGlobal": true,
  "k8s": [
    "k8s/csidriver.yaml",
    "k8s/rbac.yaml",
    "k8s/controller.yaml",
    "k8s/node.yaml"
  ],
  "parameters": {
    "VSPHERE_CSI_IMAGE": "gcr.io/cloud-provider-vsphere/csi/release/driver:v3.1.0",
    "SYNCER_IMAGE": "gcr.io/cloud-provider-vsphere/csi/release/syncer:v3.1.0",
    "REGISTRAR_IMAGE": "registry.k8s.io/sig-storage/csi-node-driver-registrar:v2.9.3",
    "PROVISIONER_IMAGE": "registry.k8s.io/sig-storage/csi-provisioner:v3.6.3",
    "NAMESPACE": "vmware-system-csi"
  },
  "parameterDefs": [
    {
      "name": "VSPHERE_CSI_IMAGE",
      "required": true,
      "default": "gcr.io/cloud-provider-vsphere/csi/release/driver:v3.1.0",
      "description": "vSphere CSI 驱动镜像（可替换为内网镜像）"
    },
    {
      "name": "NAMESPACE",
      "required": false,
      "default": "vmware-system-csi",
      "description": "CSI 驱动部署的命名空间"
    }
  ],
  "info": {
    "description": "部署 vSphere CSI 驱动（csi.vsphere.vmware.com），供 VsphereVolume 类型存储类使用。",
    "document": "https://kubernetes.io/zh-cn/docs/concepts/storage/storage-classes/"
  },
  "provisioners": [
    "vsphere"
  ]
}
